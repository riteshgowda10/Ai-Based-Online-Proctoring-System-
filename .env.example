# ExamGuard AI (PRJ 137) - Environment Configuration Template
# Duplicate this file to .env and customize for your deployment

# Application Server
FLASK_APP=src/dashboard/app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database
DATABASE_URL=sqlite:///database/proctoring.db

# Machine Learning & Vision Models
ML_DEVICE=cpu
YOLO_MODEL_PATH=models/object_detection/best.pt
FACE_SIMILARITY_THRESHOLD=0.65
YOLO_CONFIDENCE_THRESHOLD=0.55

# Logging & Storage
LOG_PATH=logs/
RECORDINGS_PATH=recordings/
REPORTS_DIR=reports/generated/
